# LLM server endpoint (llama-server or Ollama)
AGENT_LLM_URL=http://127.0.0.1:11435/v1/chat/completions

# Model name as reported by the server
AGENT_MODEL=qwen3.5-27b

# Project root (defaults to cwd if not set)
# AGENT_WORKDIR=/path/to/project

# Max agent iterations before giving up
AGENT_MAX_STEPS=50

# Max chars per tool result (truncated beyond this)
AGENT_MAX_TOOL_OUTPUT=8000

# Directory for JSONL run logs (defaults to cwd)
# AGENT_LOG_DIR=/tmp/agent-logs
