# Copy this file to targets/local/.env.local and edit local values.
# .env.local is ignored by git.

# Canonical local ATM profile. Use a llama.cpp build that supports MTP for the
# draft-mtp flags. Set this binary to your local build path in .env.local.
ATM_LLAMA_SERVER_BIN=llama-server
ATM_LLAMA_MODEL_ARG=-hf
ATM_LLAMA_MODEL=unsloth/Qwen3.6-27B-MTP-GGUF:UD-Q4_K_XL
ATM_LLAMA_ALIAS=qwen3.6-27b-mtp
ATM_LLAMA_HOST=127.0.0.1
ATM_LLAMA_PORT=11435
ATM_LLAMA_CTX_SIZE=32768
ATM_LLAMA_GPU_LAYERS=99
ATM_LLAMA_JINJA=true
ATM_LLAMA_REASONING=on
ATM_LLAMA_REASONING_BUDGET=-1
ATM_LLAMA_PARALLEL=1
ATM_LLAMA_SPEC_TYPE=draft-mtp
ATM_LLAMA_SPEC_DRAFT_N_MAX=2
ATM_LLAMA_NO_WEBUI=false
ATM_LLAMA_EXTRA_ARGS=

# For a local GGUF file instead of a Hugging Face model reference, use:
# ATM_LLAMA_MODEL_ARG=--model
# ATM_LLAMA_MODEL=/path/to/model.gguf

# Harness config. The root config defaults to 127.0.0.1:11435.
# For the MTP profile above, copy config/agent.toml to config/agent.local.toml,
# set [llm].model = "qwen3.6-27b-mtp", and point ATM_CONFIG_PATH at it.
ATM_CONFIG_PATH=config/agent.toml

# Target repository and issue input.
ATM_TARGET_REPO=/path/to/target/repo
ATM_GITHUB_REPO=owner/repo
ATM_ISSUE_NUMBER=42

# Alternative to ATM_GITHUB_REPO + ATM_ISSUE_NUMBER.
ATM_ISSUE_FILE=

# Run storage. These defaults live under the repository root and are ignored.
ATM_LOG_DIR=.atm/logs
ATM_RUN_ROOT=.atm/worktrees
ATM_BASE_REF=main
